# Copy to .env at the repository root. Never commit the filled-in .env.
# Run one Telegram bot instance per TELEGRAM_BOT_TOKEN.

# Telegram: bot token from @BotFather; positive numeric user IDs.
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_ID=123456789
# Optional additional administrators, comma-separated.
ADMIN_IDS=

# GitHub: token must access the repositories below and allow Actions/Contents
# read and write. Keep tokens scoped to only the repositories you use.
GITHUB_TOKEN=github_pat_xxxx
GITHUB_OWNER=your_github_username
GKI_REPO=GKI_KernelSU_SUSFS
GKI_DEFAULT_BRANCH=dev
# Comma-separated display_name=workflow_file.yml mappings.
GKI_WORKFLOWS=Build=main.yml
UPSTREAM_OWNER=zzh20188

# Optional OnePlus (/oki) workflow configuration.
OKI_REPO=Action-Build
OKI_DEFAULT_BRANCH=SukiSU-Ultra
OKI_WORKFLOW="Build Kernel OnePlus.yml"

# Dashboard: localhost is suitable behind Nginx. Use 0.0.0.0 only when direct
# access is intended. DASHBOARD_URL is the public URL used in notifications.
WEB_HOST=127.0.0.1
WEB_PORT=5000
DASHBOARD_URL=
# Optional renewal email; run.sh web updates this and DASHBOARD_URL for you.
CERTBOT_EMAIL=

# Local state. Relative paths resolve from the repository root.
# Keep the default when upgrading to preserve existing jobs and access keys.
STORAGE_PATH=data.json

# Optional MongoDB backup/sync; blank URI keeps local-file storage only.
MONGODB_URI=
# auto: Windows pull, Linux push. push: preserve existing local state and back
# it up (restore cloud only for a new local file). pull: load cloud snapshot on
# startup without writing back. off: disable cloud synchronization.
MONGODB_SYNC_MODE=auto
# Optional hostname allowed to write cloud data (other hosts do not push).
MONGODB_SYNC_WRITER_HOSTNAME=

# Optional self-hosted GitHub runner tools; not required to run the bot.
GITHUB_RUNNER_TOKEN=
