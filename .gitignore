gen_session.py
login.py

# Runtime data; do not overwrite existing state during deployment.
data.json
bot/data.json
*.json.bak
/data/
/logs/
/backups/
kernel-backup-*.zip
.backup-*.zip
.storage-*.json
*.log
log.txt
web/data/**/*.json
# The announcement is maintained as static content.
!web/data/announcement.json

# Python environments and caches.
venv/
.venv/
venv.incomplete.*/
.venv-check.*/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
# Local regression tests are not part of the deployed source.
/tests/
dist/
build/

